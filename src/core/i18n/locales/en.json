  "faq": {
    "title": "Help & FAQ",
    "aria": "Help and FAQ",
    "close": "Close",
    "register": {
      "q": "How do I create an account?",
      "a": "You don’t need to sign up to chat — but an account <b>reserves your nickname</b> and keeps your avatar, 2FA and settings.<ol class=\"cfaq__steps\"><li>First, enter with the nickname you want to keep.</li><li>Open <b>Settings</b> (⚙, bottom left) → <b>Account</b> tab.</li><li>Choose <b>“Create an account”</b>, enter your email and a password.</li><li>Enter the code sent by email — your nickname is protected ✅</li></ol>"
    },
    "forgot": {
      "q": "I forgot my password",
      "a": "If you’re <b>still logged in</b> to your account, change it in <b>Settings → Account → Security</b>.<br>Otherwise, ask a moderator in the channel for help, or via <a href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">{{site}}</a> — email reset is coming soon."
    },
    "free": {
      "q": "Is it really free?",
      "a": "Yes, completely. No payment, no ads. {{name}} is an open service."
    },
    "noaccount": {
      "q": "Do I have to sign up?",
      "a": "No. Pick a nickname and you’re in the channel. An account is <b>optional</b>: it’s there to protect your identity."
    },
    "taken": {
      "q": "My nickname is already taken",
