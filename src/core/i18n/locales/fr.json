    "register": {
      "q": "Comment créer un compte ?",
      "a": "Pas besoin de t’inscrire pour discuter — mais un compte <b>réserve ton pseudo</b> et garde ton avatar, ton 2FA et tes réglages.<ol class=\"cfaq__steps\"><li>Entre d’abord avec le pseudo que tu veux garder.</li><li>Ouvre les <b>Réglages</b> (⚙, en bas à gauche) → onglet <b>Compte</b>.</li><li>Choisis <b>« Créer un compte »</b>, indique ton e-mail et un mot de passe.</li><li>Saisis le code reçu par e-mail — ton pseudo est protégé ✅</li></ol>"
    },
    "forgot": {
      "q": "J’ai oublié mon mot de passe",
      "a": "Si tu es <b>encore connecté</b> à ton compte, change-le dans <b>Réglages → Compte → Sécurité</b>.<br>Sinon, demande de l’aide à un modérateur dans le salon, ou via <a href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">{{site}}</a> — la réinitialisation par e-mail arrive bientôt."
    },
    "free": {
      "q": "C’est vraiment gratuit ?",
      "a": "Oui, entièrement. Aucun paiement, aucune publicité. {{name}} est un service ouvert."
    },
