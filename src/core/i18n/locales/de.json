  "faq": {
    "title": "Hilfe & FAQ",
    "aria": "Hilfe und FAQ",
    "close": "Schließen",
    "register": {
      "q": "Wie erstelle ich ein Konto?",
      "a": "Zum Chatten brauchst du keine Anmeldung — aber ein Konto <b>reserviert deinen Spitznamen</b> und bewahrt Avatar, 2FA und Einstellungen.<ol class=\"cfaq__steps\"><li>Tritt zuerst mit dem Spitznamen ein, den du behalten willst.</li><li>Öffne die <b>Einstellungen</b> (⚙, unten links) → Reiter <b>Konto</b>.</li><li>Wähle <b>„Konto erstellen“</b>, gib deine E-Mail und ein Passwort ein.</li><li>Gib den per E-Mail erhaltenen Code ein — dein Spitzname ist geschützt ✅</li></ol>"
    },
    "forgot": {
      "q": "Ich habe mein Passwort vergessen",
      "a": "Wenn du <b>noch angemeldet</b> bist, ändere es unter <b>Einstellungen → Konto → Sicherheit</b>.<br>Andernfalls bitte einen Moderator im Kanal um Hilfe oder über <a href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">{{site}}</a> — das Zurücksetzen per E-Mail kommt bald."
    },
    "free": {
      "q": "Ist es wirklich kostenlos?",
      "a": "Ja, völlig. Keine Zahlung, keine Werbung. {{name}} ist ein offener Dienst."
    },
    "noaccount": {
      "q": "Muss ich mich anmelden?",
      "a": "Nein. Wähle einen Spitznamen und du bist im Kanal. Ein Konto ist <b>optional</b>: Es schützt deine Identität."
    },
    "taken": {
      "q": "Mein Spitzname ist bereits vergeben",
      "a": "Ein geschützter Spitzname gehört zu einem Konto. Wenn es deiner ist, klicke auf <b>„Hast du schon ein Konto?“</b>, um dich zu identifizieren. Sonst wähle einen anderen."
    },
    "privacy": {
      "q": "Sind meine Gespräche privat?",
      "a": "Die Verbindung ist <b>verschlüsselt</b> (TLS) und es gibt keinen Datenverkauf. Private Nachrichten laufen nur zwischen dir und deinem Gegenüber."
    },
    "mobile": {
      "q": "Funktioniert es auf dem Handy?",
      "a": "Ja — es ist eine installierbare App (PWA). Über deinen Browser „Zum Startbildschirm hinzufügen“ und du hast sie wie eine echte App, inklusive Benachrichtigungen."
    },
    "what": {
      "q": "Was ist {{name}}?",
      "a": "Ein Live-Chat auf dem offenen <b>IRCv3</b>-Protokoll, betrieben von <a href=\"{{project}}\" target=\"_blank\" rel=\"noopener\">Orbit</a>, einem freien Web-Client."
    }
