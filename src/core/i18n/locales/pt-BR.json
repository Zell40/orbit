    "taken": {
      "q": "Meu apelido já está em uso",
      "a": "Um apelido protegido pertence a uma conta. Se for o seu, clique em <b>«Já tem conta?»</b> para se identificar. Caso contrário, escolha outro."
    },
    "privacy": {
      "q": "Minhas conversas são privadas?",
      "a": "A conexão é <b>criptografada</b> (TLS) e não há revenda de dados. As mensagens privadas circulam apenas entre você e a outra pessoa."
    },
    "mobile": {
      "q": "Funciona no celular?",
