  "faq": {
    "title": "Ayuda & FAQ",
    "aria": "Ayuda y FAQ",
    "close": "Cerrar",
    "register": {
      "q": "¿Cómo creo una cuenta?",
      "a": "No necesitas registrarte para chatear — pero una cuenta <b>reserva tu apodo</b> y guarda tu avatar, tu 2FA y tus ajustes.<ol class=\"cfaq__steps\"><li>Primero, entra con el apodo que quieras conservar.</li><li>Abre los <b>Ajustes</b> (⚙, abajo a la izquierda) → pestaña <b>Cuenta</b>.</li><li>Elige <b>«Crear una cuenta»</b>, indica tu correo y una contraseña.</li><li>Introduce el código recibido por correo — tu apodo queda protegido ✅</li></ol>"
    },
    "forgot": {
      "q": "Olvidé mi contraseña",
      "a": "Si <b>aún tienes la sesión iniciada</b>, cámbiala en <b>Ajustes → Cuenta → Seguridad</b>.<br>Si no, pide ayuda a un moderador en el canal, o vía <a href=\"{{url}}\" target=\"_blank\" rel=\"noopener\">{{site}}</a> — el restablecimiento por correo llegará pronto."
    },
    "free": {
      "q": "¿Es realmente gratis?",
      "a": "Sí, totalmente. Sin pagos, sin anuncios. {{name}} es un servicio abierto."
    },
    "noaccount": {
      "q": "¿Tengo que registrarme?",
      "a": "No. Elige un apodo y estás en el canal. La cuenta es <b>opcional</b>: sirve para proteger tu identidad."
    },
    "taken": {
      "q": "Mi apodo ya está ocupado",
      "a": "Un apodo protegido pertenece a una cuenta. Si es el tuyo, haz clic en <b>«¿Ya tienes una cuenta?»</b> para identificarte. Si no, elige otro."
    },
    "privacy": {
      "q": "¿Mis conversaciones son privadas?",
      "a": "La conexión está <b>cifrada</b> (TLS) y no hay reventa de datos. Los mensajes privados solo circulan entre tú y la otra persona."
    },
    "mobile": {
      "q": "¿Funciona en el móvil?",
      "a": "Sí — es una app instalable (PWA). Desde tu navegador, «Añadir a la pantalla de inicio» y la tienes como una app de verdad, con notificaciones incluidas."
    },
    "what": {
      "q": "¿Qué es {{name}}?",
      "a": "Un chat en directo construido sobre el protocolo abierto <b>IRCv3</b> e impulsado por <a href=\"{{project}}\" target=\"_blank\" rel=\"noopener\">Orbit</a>, un cliente web libre."
    }
  },
